</div>
<div class="fig">
<svg width="660" height="240" viewBox="0 0 660 240">
  <line x1="40" y1="200" x2="630" y2="200" stroke="#0f3460" stroke-width="2"/>
  <rect x="80" y="46" width="130" height="154" fill="#0f3460"/>
  <text x="145" y="115" font-size="13" text-anchor="middle" fill="#ffffff">65%~70%</text>
